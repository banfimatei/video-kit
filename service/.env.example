# Copy to service/.env for local runs (loaded at startup if present; variables
# already set in the environment win). On Railway, set these as service
# variables instead: the image never contains a .env.

# Required. Clients send it as `Authorization: Bearer <key>`. 32+ random chars.
RENDER_API_KEY=

# Voice for `narration` props: set one (first found wins), or pass `tts` per render.
# TTS_PROVIDER=elevenlabs            # force one: elevenlabs | openai | gemini | openrouter | espeak | none
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=onyx
# OPENAI_TTS_INSTRUCTIONS=Measured, neutral delivery. No hype.
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Charon
# OPENROUTER_API_KEY=
# OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts   # any model with speech output on openrouter.ai
# OPENROUTER_TTS_VOICE=Charon                        # voices are per model (supported_voices on the models API)
# OPENROUTER_TTS_INSTRUCTIONS=Measured, neutral delivery. No hype.
# ESPEAK_VOICE=en-us
# ESPEAK_SPEED=165

# Word timings on voiced clips: Deepgram speech-to-text times each clip once (cached next to it).
# Without a key they are estimated from the text, which is good to a word or so.
# DEEPGRAM_API_KEY=

# Secrets derived from RENDER_API_KEY unless set (rotating the key rotates them).
# SIGNING_SECRET=                    # signs file links
# WEBHOOK_SECRET=                    # signs webhook bodies; give receivers this, never RENDER_API_KEY

# Storage: a volume mounted here (Railway: /data).
# DATA_DIR=/data
# Public origin for file links. Railway sets RAILWAY_PUBLIC_DOMAIN, which is used by default.
# PUBLIC_URL=https://render.example.com
# PORT=8080
# HOST=::

# Redeploys: seconds running renders get to finish after SIGTERM. On Railway,
# set the variable RAILWAY_DEPLOYMENT_DRAINING_SECONDS (it both sets Railway's
# window and tells the service); the Settings field alone is invisible here.
# DRAINING_SECONDS=300

# Limits and housekeeping (defaults shown).
# RENDER_CONCURRENCY=1
# FRAME_CONCURRENCY=                 # Remotion's default: half the cores
# MAX_QUEUE=25
# MAX_RENDER_SECONDS=180
# JOB_TIMEOUT_MINUTES=45
# MAX_NARRATION_CHARS=12000
# MAX_NARRATION_LINES=40
# MAX_SITE_MB=300
# MAX_BODY_KB=1024
# RETENTION_DAYS=7
# URL_TTL_HOURS=168
# VOICE_CACHE_DAYS=30
# ALLOW_PRIVATE_URLS=0               # 1: webhooks and Story media may use private hosts (e.g. *.railway.internal)

# Local only: point at a headless Chrome when Remotion can't download its own.
# REMOTION_BROWSER_EXECUTABLE=
